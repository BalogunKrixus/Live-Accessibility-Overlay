{
  "manifest_version": 3,
  "name": "Live Accessibility Overlay",
  "version": "1.0.0",
  "description": "See accessibility problems on the live page, in context. Contrast, headings, alt text and tab order — measured locally, never uploaded.",
  "minimum_chrome_version": "111",

  "permissions": ["activeTab", "scripting", "storage"],

  "action": {
    "default_title": "Live Accessibility Overlay — toggle (Alt+Shift+A)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle the accessibility overlay"
    }
  }
}
